# ---------------------------------------------------------------------------
# Cloud Run environment variables for the Vector backend - PLACEHOLDERS ONLY.
#
#   1. Copy this file to `cloudrun.env.yaml`  (git-ignored)
#   2. Replace every YOUR_* / REPLACE_* value
#   3. Apply it (this REPLACES every environment variable on the service, so
#      list every non-secret key you need):
#
#        gcloud run services update vector-app `
#          --region asia-south1 --project YOUR_GCP_PROJECT_ID `
#          --env-vars-file=scripts/gcp/cloudrun.env.yaml
#
# Why a file rather than --update-env-vars?
#   --update-env-vars splits its value on commas, and CORS_ORIGINS is a comma
#   separated list, so the naive form silently truncates it. A file has no such
#   limit. (For an ad-hoc update from a shell use gcloud's escaping form:
#   --update-env-vars=^@^CORS_ORIGINS=https://a,https://b@APP_ENV=production)
#
# SECRETS DO NOT BELONG IN THIS FILE.
# JWT_SECRET, PASSWORD_RESET_SECRET, MICROSOFT_CLIENT_SECRET and SMTP_PASSWORD
# are injected by Google Secret Manager with --update-secrets; see
# docs/gcp-firebase-blue-green.md.  Blue and Green share this single service
# configuration, which is exactly why both see the same JWT_SECRET and the same
# Firebase project.
# ---------------------------------------------------------------------------

# ---- Runtime -----------------------------------------------------------------
APP_ENV: "production"
DEBUG: "false"
PORT: "8080"

# ---- HTTP / CORS -------------------------------------------------------------
# Comma separated, no spaces, no wildcard. Both Hosting domains are needed
# because either can serve the app.
CORS_ORIGINS: "https://YOUR_GCP_PROJECT_ID.web.app,https://YOUR_GCP_PROJECT_ID.firebaseapp.com,https://YOUR_CUSTOM_DOMAIN,http://localhost:3000,http://localhost:5000"

# Opt-in: allow THIS project's own Hosting preview channels
# (https://<siteId>--<channelId>-<hash>.web.app) so a green frontend can be
# validated before promotion. Leave "false" if you never preview.
CORS_ALLOW_PREVIEW_CHANNELS: "false"
FIREBASE_SITE_ID: "YOUR_GCP_PROJECT_ID"

# ---- Firebase / Storage ------------------------------------------------------
FIREBASE_STORAGE_BUCKET: "YOUR_GCP_PROJECT_ID.firebasestorage.app"

# ---- Authentication ----------------------------------------------------------
# Non-secret tuning only. JWT_SECRET itself comes from Secret Manager.
JWT_EXPIRY_HOURS: "8"

# ---- Password reset mail -----------------------------------------------------
# "microsoft_graph" (default) or "smtp".
MAIL_PROVIDER: "microsoft_graph"
MICROSOFT_TENANT_ID: "YOUR_TENANT_ID"
MICROSOFT_CLIENT_ID: "YOUR_CLIENT_ID"
MICROSOFT_SENDER_EMAIL: "no-reply@YOUR_DOMAIN"
SMTP_HOST: "smtp.YOUR_DOMAIN"
SMTP_PORT: "587"
SMTP_USERNAME: "YOUR_SMTP_USER"
SMTP_FROM_EMAIL: "no-reply@YOUR_DOMAIN"
SMTP_USE_TLS: "true"
SMTP_USE_SSL: "false"

# ---- Password reset tuning (optional; defaults shown) ------------------------
PASSWORD_RESET_OTP_MINUTES: "10"
PASSWORD_RESET_TOKEN_MINUTES: "10"
PASSWORD_RESET_RESEND_SECONDS: "60"
PASSWORD_RESET_MAX_ATTEMPTS: "5"

# ---- Links used inside the reset e-mail --------------------------------------
APP_FRONTEND_URL: "https://YOUR_CUSTOM_DOMAIN"

# ---- Google application credentials -----------------------------------------
# Leave this OUT of the file entirely. Cloud Run supplies Application Default
# Credentials from the runtime service account automatically; the app must not
# be given a service-account key file, and backend/.dockerignore already keeps
# *.json out of the image. Only a local (non-Cloud Run) run would ever need:
# GOOGLE_APPLICATION_CREDENTIALS
