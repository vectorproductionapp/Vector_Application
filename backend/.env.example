# ---------------------------------------------------------------------------
# Backend configuration template  (placeholders only - never put real values here)
#
#   Local development : copy to `backend/.env`         (git-ignored)
#   Cloud Run         : do NOT use this file - set the same keys as Cloud Run
#                       environment variables, and put the secret values in
#                       Google Secret Manager referenced with --update-secrets.
#                       `docs/gcp-firebase-blue-green.md` has the exact commands.
#
# `backend/.env` and `backend/.env.production` are git-ignored and must stay so.
# ---------------------------------------------------------------------------

# ---- Runtime -----------------------------------------------------------------
# `production` makes app.py look for `.env.production`; in Cloud Run there is no
# .env file at all, so APP_ENV only controls debug-style behaviour.
APP_ENV=production
DEBUG=false
# HOST is only used by `python app.py`. Cloud Run injects PORT itself.
HOST=0.0.0.0
PORT=8080

# ---- HTTP / CORS -------------------------------------------------------------
# Comma separated, no spaces. Include BOTH Firebase Hosting domains (either can
# serve the app), the custom domain, and localhost for local work. Never "*".
CORS_ORIGINS=https://YOUR_PROJECT_ID.web.app,https://YOUR_PROJECT_ID.firebaseapp.com,https://YOUR_CUSTOM_DOMAIN,http://localhost:3000,http://localhost:5000

# Optional, off by default. When true, this project's own Firebase Hosting
# *preview* channels are allowed through CORS so a green frontend can be tested
# before promotion, without opening CORS to the whole *.web.app domain.
CORS_ALLOW_PREVIEW_CHANNELS=false
# Globally unique Hosting site id, equal to the Firebase project id.
FIREBASE_SITE_ID=YOUR_PROJECT_ID

# ---- Authentication ----------------------------------------------------------
# Generate with:  openssl rand -hex 32   (or the PowerShell equivalent in the
# docs). MUST be identical across Blue and Green or every session breaks on
# promote/rollback. Store it in Secret Manager, never in this file.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE
JWT_EXPIRY_HOURS=8

# ---- Firebase / Google -------------------------------------------------------
# Storage bucket the application uploads to.
FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app

# Credentials are OPTIONAL in Cloud Run: the runtime service account is used via
# Application Default Credentials. Only set these for a local run against a
# service-account key, and never commit the key itself.
#GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
#FIREBASE_CREDENTIALS_PATH=/absolute/path/to/service-account.json

# ---- Password reset mail -----------------------------------------------------
# "microsoft_graph" (default) or "smtp".
MAIL_PROVIDER=microsoft_graph

# Microsoft Graph (MAIL_PROVIDER=microsoft_graph)
MICROSOFT_TENANT_ID=YOUR_TENANT_ID
MICROSOFT_CLIENT_ID=YOUR_CLIENT_ID
MICROSOFT_CLIENT_SECRET=REPLACE_WITH_A_SECRET_VALUE
MICROSOFT_SENDER_EMAIL=no-reply@YOUR_DOMAIN

# SMTP (MAIL_PROVIDER=smtp) - e.g. Gmail app password, or Microsoft 365 SMTP
SMTP_HOST=smtp.YOUR_DOMAIN
SMTP_PORT=587
SMTP_USERNAME=YOUR_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_A_SECRET_VALUE
SMTP_FROM_EMAIL=no-reply@YOUR_DOMAIN
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Optional, independent of the provider choice above (legacy key still read).
PASSWORD_RESET_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE

# Password reset tuning (seconds / minutes) - optional, defaults shown.
PASSWORD_RESET_OTP_MINUTES=10
PASSWORD_RESET_TOKEN_MINUTES=10
PASSWORD_RESET_RESEND_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5

# Links and artwork used inside the reset e-mail.
APP_FRONTEND_URL=https://YOUR_CUSTOM_DOMAIN
#EMAIL_LOGO_URL=https://YOUR_CUSTOM_DOMAIN/logo.png
#EMAIL_LOGO_PATH=assets/vector-logo.png

# ---- Gunicorn (advanced, optional) ------------------------------------------
# See backend/Dockerfile. WEB_CONCURRENCY must stay 1 while realtime.py keeps
# broadcasting in-process.
#WEB_CONCURRENCY=1
#GUNICORN_THREADS=16
#GUNICORN_TIMEOUT=0
