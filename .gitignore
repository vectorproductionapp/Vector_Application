# Node / React
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
/build/
/dist/
/coverage/

# Environment files and secrets
.env
.env.*
backend/.env
backend/.env.*
# ...but the placeholder-only templates are meant to be committed.
!.env.example
!backend/.env.example

# Firebase / GCP local credentials
.firebaserc
firebase-debug.log
.firebase/
backend/*.json
!backend/requirements.json
*-firebase-adminsdk-*.json
gcloud-*.log

# Deployment scripts: operator-specific config and local release state
# (never committed, never a secret store). The *.example / *.yaml.example
# templates ARE committed - they hold placeholders only.
scripts/gcp/config.ps1
scripts/gcp/cloudrun.env.yaml
scripts/gcp/.state/
scripts/firebase/config.ps1
scripts/firebase/.state/

# Python
__pycache__/
*.py[cod]
*.pyd
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Logs, temporary files, IDE and OS files
*.log
*.tmp
*.temp
*.swp
*.swo
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini
.pnp/
.pnp.js
