# ---------------------------------------------------------------------------
# Frontend (Create React App) configuration template - placeholders only.
#
#   Local development : copy to `.env` (git-ignored)
#   Production build  : do NOT create `.env.production` for CI. GitHub Actions
#                       injects REACT_APP_API_BASE_URL from the repository
#                       variable of the same name, and scripts/firebase/*.ps1
#                       pass it explicitly.
#
# CRA inlines these at build time; changing them requires a rebuild.
# ---------------------------------------------------------------------------

# REST base URL of the Cloud Run backend (stable service URL or custom API
# domain - never a revision-specific URL, which dies on the next deploy).
REACT_APP_API_BASE_URL=http://localhost:5000

# Optional. Live-update WebSocket (/ws) endpoint. When unset it is derived from
# REACT_APP_API_BASE_URL, which is what production wants. Set it only when the
# socket must live on a different host than the REST API.
#REACT_APP_WS_BASE_URL=ws://localhost:5000

# Optional diagnostics (prints per-request API timings in the browser console).
#REACT_APP_API_PERF_LOGGING=true
